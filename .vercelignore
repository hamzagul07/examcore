# What gets uploaded when deploying from the CLI.
#
# This is an allowlist, not a denylist, and that is deliberate. The repo root
# doubles as a research library — IB specimen papers, subject guides, site
# scrapes, loose PDFs — roughly 50,000 files and 3GB, none of it tracked in git
# and none of it read by the build. A denylist meant a new folder of source
# material silently broke the next deploy: the API rejects any upload over
# 15,000 files, and 3GB of it aborted mid-transfer anyway.
#
# So: ignore everything, then add back what the build actually reads. If a
# genuinely new build input appears, the build fails loudly with a missing
# import rather than quietly shipping 3GB.

/*
.*

# Source.
!/app
!/lib
!/components
!/content
!/scripts
!/public
!/data
!/supabase

# Config the build needs.
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/next.config.ts
!/postcss.config.mjs
!/eslint.config.mjs
!/components.json
!/vercel.json
!/proxy.ts
!/instrumentation.ts
!/instrumentation-client.ts
!/sentry.edge.config.ts
!/sentry.server.config.ts
!/pdfjs-dist-shim.d.ts
!/next-env.d.ts

# Never upload, even though the rules above would not have caught them.
node_modules
.next
.git
.env*.local
tmp
